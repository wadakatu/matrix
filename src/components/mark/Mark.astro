---
/** The home link: the logo, then the wordmark, which names the link. */
import Logo from "../logo/Logo.astro";
interface Props {
  href: string;
  /** The wordmark, e.g. `wadakatu_`. Site data. */
  label: string;
  /** Address of the logo file. */
  logo: string;
  /** On a page with two readings: home in each, so the link follows an in-place change (task 3.6). */
  to?: { human: string; machine: string };
}
const { href, label, logo, to } = Astro.props;
---
<a class="mx-mark" href={href} data-human-href={to?.human} data-machine-href={to?.machine}><Logo src={logo} />{label}</a>
