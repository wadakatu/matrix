---
/**
 * The page's header: the Mark, then the Menu holding the Nav and the controls. The reading switch
 * (task 3.5) goes in the `switch` slot, first among the controls, as in the prototype.
 */
import Mark from "../mark/Mark.astro";
import Menu from "../menu/Menu.astro";
import Nav, { type NavItem } from "../nav/Nav.astro";
import Control from "../control/Control.astro";
import LangLink from "../lang/LangLink.astro";
import type { Lang } from "../../strings/index.ts";
interface Props {
  mark: { href: string; label: string; logo: string };
  nav: NavItem[];
  /** The same page in the other language, where it has a twin (L6, decision Q8). */
  alternate?: string;
  lang?: Lang;
  /** Below 720px: the menu starts unfolded (stories). */
  open?: boolean;
}
const { mark, nav, alternate, lang = "en", open } = Astro.props;
---
<header class="mx-header mx-frame">
  <Mark {...mark} />
  <Menu lang={lang} open={open}>
    <Nav items={nav} lang={lang} />
    <div class="mx-controls">
      <slot name="switch" />
      <Control action="hold" lang={lang} />
      <Control action="palette" lang={lang} />
      <Control action="theme" lang={lang} />
      {alternate && <LangLink href={alternate} lang={lang} />}
    </div>
  </Menu>
</header>
