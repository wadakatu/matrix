---
/**
 * The Terminal as the specimens use it, with the demo interpreter and the fixture's session (06). In a
 * story the play function gives the element its interpreter (`live` in stories.ts); without it, this is
 * the recorded session. `contexts`: four scopes, each with its own field id.
 */
import Terminal from "../components/terminal/Terminal.astro";
import Rain from "../effects/rain/Rain.astro";
import { chips, demo, login, sessions } from "./terminal.ts";
import { signature } from "./corpus.ts";
import type { Lang } from "../strings/index.ts";
interface Props {
  lang?: Lang;
  page?: "home" | "projects";
  /** The first commands of the session only. */
  short?: boolean;
  contexts?: boolean;
  /** The rain overlay (`cmatrix`) drawn over it: needs the 機械用 reading. */
  overlay?: boolean;
}
const { lang = "en", page = "home", short = true, contexts, overlay } = Astro.props;
const ja = ["neofetch", "cat posts/fixture-post-one.md", "cat projects/fixture-four.md"];
const session = lang === "ja" ? ja : short ? sessions[page].slice(0, page === "home" ? 3 : 2) : sessions[page];
const props = (id: string) => ({ interpreter: demo(page === "projects" ? "projects" : ""), session, chips, human: "#human", login: page === "home" ? login : undefined, lang, id });
const scopes = [["phosphor", "night"], ["phosphor", "day"], ["operator", "night"], ["operator", "day"]];
---
{overlay && <Rain phrases={signature.phrases} />}
{contexts ? (
  <div class="fixture-contexts">
    {scopes.map(([palette, theme], i) => (
      <div class="fixture-scope" data-palette={palette} data-theme={theme}>
        <p class="fixture-scope-name" lang="en">{palette}-{theme}</p>
        <div class="mx-frame"><Terminal {...props(`mx-command-${i}`)} /></div>
      </div>
    ))}
  </div>
) : (
  <div class="mx-frame"><Terminal {...props("mx-command")} /></div>
)}
{overlay && <script is:inline>document.querySelector("mx-terminal").dataset.overlay = "rain";</script>}
